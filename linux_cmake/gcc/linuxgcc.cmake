# TOOLCHAIN EXTENSION
IF(WIN32)
    SET(TOOLCHAIN_EXT ".exe")
ELSE()
    SET(TOOLCHAIN_EXT "")
ENDIF()

set(CMAKE_SYSTEM_NAME      Generic)
set(CMAKE_SYSTEM_PROCESSOR native)

# TOOLCHAIN_DIR AND NANO LIBRARY
SET(TOOLCHAIN_DIR $ENV{NATIVE_GCC_DIR})
STRING(REGEX REPLACE "\\\\" "/" TOOLCHAIN_DIR "${TOOLCHAIN_DIR}")

IF(NOT TOOLCHAIN_DIR)
    MESSAGE(FATAL_ERROR "***Please set NATIVE_GCC_DIR in envionment variables***")
ENDIF()

MESSAGE(STATUS "TOOLCHAIN_DIR: " ${TOOLCHAIN_DIR})

# versioning definitions (POM_FW_xx are defined in POM file, GO_ENVIRONMENT_NAME is defined in QA build server)
SET(VERSIONING_CONTROL "")
if (DEFINED ENV{POM_FW_VERSION_MAJOR})
    SET(VERSIONING_CONTROL "${VERSIONING_CONTROL} -D_FW_VERSION_MAJOR=$ENV{POM_FW_VERSION_MAJOR}")
endif()
if (DEFINED ENV{POM_FW_VERSION_MINOR})
    SET(VERSIONING_CONTROL "${VERSIONING_CONTROL} -D_FW_VERSION_MINOR=$ENV{POM_FW_VERSION_MINOR}")
endif()
if (DEFINED ENV{POM_FW_VERSION_REVISION})
    SET(VERSIONING_CONTROL "${VERSIONING_CONTROL} -D_FW_VERSION_REVISION=$ENV{POM_FW_VERSION_REVISION}")
endif()
if (DEFINED ENV{POM_FW_SVN_REVISION})
    SET(VERSIONING_CONTROL "${VERSIONING_CONTROL} -D_FW_SVN_REVISION=$ENV{POM_FW_SVN_REVISION}")
endif()
if (DEFINED ENV{POM_FW_BUILD_MODE})
    SET(_FW_BUILD_MODE "$ENV{POM_FW_BUILD_MODE}")
    if("${_FW_BUILD_MODE}" STREQUAL "SNAPSHOT")
        SET(VERSIONING_CONTROL "${VERSIONING_CONTROL} -D_FW_SNAPSHOT_MODE")
    elseif("${_FW_BUILD_MODE}" STREQUAL "")
        SET(VERSIONING_CONTROL "${VERSIONING_CONTROL} -D_FW_RELEASE_MODE")
    else()
        SET(VERSIONING_CONTROL "${VERSIONING_CONTROL} -D_FW_${_FW_BUILD_MODE}")
    endif()
endif()
if (DEFINED ENV{GO_ENVIRONMENT_NAME})
    SET(VERSIONING_CONTROL "${VERSIONING_CONTROL} -D_FW_QA_SERVER_MODE")
endif()
	
# TARGET_TRIPLET
SET(TARGET_TRIPLET "")
SET(TOOLCHAIN_BIN_DIR ${TOOLCHAIN_DIR}/bin)

SET(CMAKE_C_COMPILER ${TOOLCHAIN_BIN_DIR}/gcc${TOOLCHAIN_EXT})
SET(CMAKE_CXX_COMPILER ${TOOLCHAIN_BIN_DIR}/g++${TOOLCHAIN_EXT})
SET(CMAKE_ASM_COMPILER ${CMAKE_C_COMPILER})
set(CMAKE_LINKER ${TOOLCHAIN_BIN_DIR}/ld${TOOLCHAIN_EXT})
set(CMAKE_OBJCOPY ${TOOLCHAIN_BIN_DIR}/objcopy${TOOLCHAIN_EXT})
set(CMAKE_RANLIB ${TOOLCHAIN_BIN_DIR}/ranlib${TOOLCHAIN_EXT})
set(CMAKE_SIZE ${TOOLCHAIN_BIN_DIR}/size${TOOLCHAIN_EXT})
set(CMAKE_STRIP ${TOOLCHAIN_BIN_DIR}/strip${TOOLCHAIN_EXT})
set(CMAKE_C_LINK_EXECUTABLE "${CMAKE_C_COMPILER} <CMAKE_C_LINK_FLAGS> <LINK_FLAGS> <OBJECTS>  -o <TARGET> <LINK_LIBRARIES>")

set(CMAKE_C_COMPILER_FORCED TRUE)
set(CMAKE_CXX_COMPILER_FORCED TRUE)

SET(CMAKE_OBJCOPY ${TOOLCHAIN_BIN_DIR}/objcopy CACHE INTERNAL "objcopy tool")
SET(CMAKE_OBJDUMP ${TOOLCHAIN_BIN_DIR}/objdump CACHE INTERNAL "objdump tool")
set(MCPU_FLAGS "-march=native")
set(VFP_FLAGS "")
#set(COMMON_FLAGS "-fprofile-arcs -ftest-coverage")
set(Coverage_FLAGS "-fprofile-arcs -ftest-coverage")
#set(COMMON_FLAGS_XX "-fprofile-arcs -ftest-coverage")
set(LD_FLAGS "${LD_FLAGS} -ftest-coverage -fprofile-arcs")
set(DEFINES_DEBUG "-DDEBUG")
set(DEFINES_RELEASE "-DNDEBUG")

# if application layer do not define RELEASE_WARNINGS_NOT_AS_ERROR, warnings will trigger a compiler error
if (NOT DEFINED RELEASE_WARNINGS_NOT_AS_ERROR)
    set(SET_RELEASE_WARNINGS_AS_ERROR "-Werror")
endif ()

if (NOT DEFINED DEBUG_OPTIMIZATION_FLAGS)
    set(DEBUG_OPTIMIZATION_FLAGS "-O0")
endif ()

if (NOT DEFINED RELEASE_OPTIMIZATION_FLAGS)
    set(RELEASE_OPTIMIZATION_FLAGS "-O3")
endif ()

SET(CMAKE_C_FLAGS_DEBUG "${CMAKE_C_FLAGS_DEBUG} ${MCPU_FLAGS} ${VFP_FLAGS} ${DEFINES_DEBUG} ${DEBUG_OPTIMIZATION_FLAGS} -Wall -g ${COMMON_FLAGS}" CACHE INTERNAL "c compiler flags debug")
SET(CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} ${MCPU_FLAGS} ${VFP_FLAGS} ${DEFINES_DEBUG} ${DEBUG_OPTIMIZATION_FLAGS} -Wall -g ${COMMON_FLAGS} ${COMMON_FLAGS_XX}" CACHE INTERNAL "cxx compiler flags debug")
SET(CMAKE_ASM_FLAGS_DEBUG "${CMAKE_ASM_FLAGS_DEBUG} ${MCPU_FLAGS} ${VFP_FLAGS} ${DEFINES_DEBUG} -g" CACHE INTERNAL "asm compiler flags debug")
SET(CMAKE_EXE_LINKER_FLAGS_DEBUG "${CMAKE_EXE_LINKER_FLAGS_DEBUG}" CACHE INTERNAL "linker flags debug")

SET(CMAKE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS_RELEASE} ${MCPU_FLAGS} ${VFP_FLAGS} ${DEFINES_RELEASE} ${RELEASE_OPTIMIZATION_FLAGS} ${COMMON_FLAGS} ${SET_RELEASE_WARNINGS_AS_ERROR}" CACHE INTERNAL "c compiler flags release")
SET(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} ${MCPU_FLAGS} ${VFP_FLAGS} ${DEFINES_RELEASE} ${RELEASE_OPTIMIZATION_FLAGS} ${COMMON_FLAGS} ${COMMON_FLAGS_XX} ${SET_RELEASE_WARNINGS_AS_ERROR}" CACHE INTERNAL "cxx compiler flags release")
SET(CMAKE_ASM_FLAGS_RELEASE "${CMAKE_ASM_FLAGS_RELEASE} ${MCPU_FLAGS} ${VFP_FLAGS} ${DEFINES_RELEASE}" CACHE INTERNAL "asm compiler flags release")
SET(CMAKE_EXE_LINKER_FLAGS_RELEASE "${CMAKE_EXE_LINKER_FLAGS_RELEASE}" CACHE INTERNAL "linker flags release")

#set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -libwinmm -fprofile-arcs --coverage")
set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -libwinmm")
set(CMAKE_EXECUTABLE_SUFFIX_ASM ".exe")
set(CMAKE_EXECUTABLE_SUFFIX_C ".exe")
set(CMAKE_EXECUTABLE_SUFFIX_CXX ".exe")

MESSAGE(STATUS "BUILD_TYPE: " ${CMAKE_BUILD_TYPE})
